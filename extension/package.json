{
  "name": "pi-dual-engine",
  "version": "0.2.2",
  "description": "One-owner-per-byte coordination between the Caveman harness engine and the Headroom wire engine (dual-engine).",
  "type": "module",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=esm --outdir dist --external @earendil-works/pi-coding-agent --external @earendil-works/pi-ai --external typebox",
    "format": "biome format src test scripts",
    "lint": "biome lint src test scripts && tsc --noEmit",
    "test": "bun test",
    "check": "bun run format && bun run lint && bun run test && bun run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "typebox": "^1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/bun": "^1.4.4",
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
